@@ -403,6 +403,16 @@ std::vector<uint8_t> ArchiveDecompressor::readData(const std::string &fname)
     if (tmpExtractIfPossible()) {
         fs::path extractedPath = m_tmpDir / fs::path(fname).relative_path();
         try {
+            // rebase absolute symlink targets onto the extraction directory,
+            // as-is they would point at paths of the host system
+            for (int i = 0; fs::is_symlink(extractedPath) && i < 10; ++i) {
+                const auto target = fs::read_symlink(extractedPath);
+                if (target.is_absolute())
+                    extractedPath = m_tmpDir / target.relative_path();
+                else
+                    extractedPath = extractedPath.parent_path() / target;
+            }
+
             std::ifstream file(extractedPath, std::ios::binary);
             if (!file)
                 throw std::runtime_error(std::format("Failed to open extracted file: {}", extractedPath.string()));
